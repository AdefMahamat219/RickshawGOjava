<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="ui.SettingsController"
    prefWidth="460"
    prefHeight="520">

    <!-- TOP -->
    <top>
        <HBox
            styleClass="top-bar"
            alignment="CENTER_LEFT"
            spacing="10">
            <padding>
                <Insets top="0" right="20"
                        bottom="0" left="20"/>
            </padding>
            <VBox alignment="CENTER_LEFT"
                  spacing="1">
                <Label
                    text="⚙️ Settings"
                    styleClass="app-title"/>
                <Label
                    text="Customize fare rates"
                    styleClass="app-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button
                text="← Back"
                styleClass="btn-toolbar"
                onAction="#onBack"/>
        </HBox>
    </top>

    <!-- CENTER -->
    <center>
        <VBox spacing="0">
            <padding>
                <Insets top="20" right="24"
                        bottom="20" left="24"/>
            </padding>

            <!-- Fare Rates -->
            <Label
                text="FARE RATES"
                styleClass="label-section">
                <VBox.margin>
                    <Insets bottom="14"/>
                </VBox.margin>
            </Label>

            <GridPane hgap="12" vgap="12">
                <VBox.margin>
                    <Insets bottom="20"/>
                </VBox.margin>

                <Label
                    text="Base Rate (first km)"
                    styleClass="muted-label"
                    GridPane.columnIndex="0"
                    GridPane.rowIndex="0"/>
                <HBox spacing="6"
                      alignment="CENTER_LEFT"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="0">
                    <TextField
                        fx:id="baseRateField"
                        prefWidth="100"/>
                    <Label
                        text="BDT"
                        styleClass="muted-label"/>
                </HBox>

                <Label
                    text="Rate per KM"
                    styleClass="muted-label"
                    GridPane.columnIndex="0"
                    GridPane.rowIndex="1"/>
                <HBox spacing="6"
                      alignment="CENTER_LEFT"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="1">
                    <TextField
                        fx:id="perKmRateField"
                        prefWidth="100"/>
                    <Label
                        text="BDT / km"
                        styleClass="muted-label"/>
                </HBox>

                <Label
                    text="Night Multiplier"
                    styleClass="muted-label"
                    GridPane.columnIndex="0"
                    GridPane.rowIndex="2"/>
                <HBox spacing="6"
                      alignment="CENTER_LEFT"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="2">
                    <TextField
                        fx:id="nightMultField"
                        prefWidth="100"/>
                    <Label
                        text="×"
                        styleClass="muted-label"/>
                </HBox>

                <Label
                    text="Peak Hour Multiplier"
                    styleClass="muted-label"
                    GridPane.columnIndex="0"
                    GridPane.rowIndex="3"/>
                <HBox spacing="6"
                      alignment="CENTER_LEFT"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="3">
                    <TextField
                        fx:id="peakMultField"
                        prefWidth="100"/>
                    <Label
                        text="×"
                        styleClass="muted-label"/>
                </HBox>

            </GridPane>

            <Separator>
                <VBox.margin>
                    <Insets bottom="20"/>
                </VBox.margin>
            </Separator>

            <!-- Night Hours -->
            <Label
                text="NIGHT HOURS"
                styleClass="label-section">
                <VBox.margin>
                    <Insets bottom="14"/>
                </VBox.margin>
            </Label>

            <GridPane hgap="12" vgap="12">
                <VBox.margin>
                    <Insets bottom="20"/>
                </VBox.margin>

                <Label
                    text="Night Starts At"
                    styleClass="muted-label"
                    GridPane.columnIndex="0"
                    GridPane.rowIndex="0"/>
                <HBox spacing="6"
                      alignment="CENTER_LEFT"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="0">
                    <TextField
                        fx:id="nightStartField"
                        prefWidth="100"/>
                    <Label
                        text=":00 (24hr)"
                        styleClass="muted-label"/>
                </HBox>

                <Label
                    text="Night Ends At"
                    styleClass="muted-label"
                    GridPane.columnIndex="0"
                    GridPane.rowIndex="1"/>
                <HBox spacing="6"
                      alignment="CENTER_LEFT"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="1">
                    <TextField
                        fx:id="nightEndField"
                        prefWidth="100"/>
                    <Label
                        text=":00 (24hr)"
                        styleClass="muted-label"/>
                </HBox>

            </GridPane>

            <Separator>
                <VBox.margin>
                    <Insets bottom="16"/>
                </VBox.margin>
            </Separator>

            <!-- Status -->
            <Label
                fx:id="statusLabel"
                text=""
                styleClass="success-label">
                <VBox.margin>
                    <Insets bottom="16"/>
                </VBox.margin>
            </Label>

            <!-- Buttons -->
            <HBox spacing="8"
                  alignment="CENTER_RIGHT">
                <Button
                    text="Reset Default"
                    styleClass="btn-secondary"
                    onAction="#onResetDefault"/>
                <Button
                    text="Save Settings"
                    styleClass="btn-primary"
                    onAction="#onSaveSettings"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>
