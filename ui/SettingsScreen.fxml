<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="ui.SettingsController"
    prefWidth="450"
    prefHeight="500">

    <!-- ── TOP TOOLBAR ── -->
    <top>
        <HBox
            styleClass="top-bar"
            alignment="CENTER_LEFT"
            spacing="10">
            <padding>
                <Insets top="10" right="15"
                        bottom="10" left="15"/>
            </padding>

            <Label
                text="⚙️ Settings"
                styleClass="app-title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button
                text="← Back"
                styleClass="btn-secondary"
                onAction="#onBack"/>

        </HBox>
    </top>

    <!-- ── CENTER CONTENT ── -->
    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="20" right="20"
                        bottom="20" left="20"/>
            </padding>

            <!-- Fare Rates Section -->
            <Label
                text="💰 Fare Rates"
                styleClass="panel-title"/>

            <Separator/>

            <GridPane hgap="15" vgap="12">

                <!-- Base Rate -->
                <Label
                    text="Base Rate (first km):"
                    GridPane.columnIndex="0"
                    GridPane.rowIndex="0"/>
                <HBox
                    spacing="5"
                    alignment="CENTER_LEFT"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="0">
                    <TextField
                        fx:id="baseRateField"
                        prefWidth="100"/>
                    <Label text="BDT"/>
                </HBox>

                <!-- Per KM Rate -->
                <Label
                    text="Rate per KM:"
                    GridPane.columnIndex="0"
                    GridPane.rowIndex="1"/>
                <HBox
                    spacing="5"
                    alignment="CENTER_LEFT"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="1">
                    <TextField
                        fx:id="perKmRateField"
                        prefWidth="100"/>
                    <Label text="BDT / km"/>
                </HBox>

                <!-- Night Multiplier -->
                <Label
                    text="Night Ride Multiplier:"
                    GridPane.columnIndex="0"
                    GridPane.rowIndex="2"/>
                <HBox
                    spacing="5"
                    alignment="CENTER_LEFT"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="2">
                    <TextField
                        fx:id="nightMultField"
                        prefWidth="100"/>
                    <Label text="×"/>
                </HBox>

                <!-- Peak Multiplier -->
                <Label
                    text="Peak Hour Multiplier:"
                    GridPane.columnIndex="0"
                    GridPane.rowIndex="3"/>
                <HBox
                    spacing="5"
                    alignment="CENTER_LEFT"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="3">
                    <TextField
                        fx:id="peakMultField"
                        prefWidth="100"/>
                    <Label text="×"/>
                </HBox>

            </GridPane>

            <Separator/>

            <!-- Night Hours Section -->
            <Label
                text="🌙 Night Hours"
                styleClass="panel-title"/>

            <GridPane hgap="15" vgap="12">

                <!-- Night Start -->
                <Label
                    text="Night Starts At:"
                    GridPane.columnIndex="0"
                    GridPane.rowIndex="0"/>
                <HBox
                    spacing="5"
                    alignment="CENTER_LEFT"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="0">
                    <TextField
                        fx:id="nightStartField"
                        prefWidth="100"/>
                    <Label text=":00 (24hr)"/>
                </HBox>

                <!-- Night End -->
                <Label
                    text="Night Ends At:"
                    GridPane.columnIndex="0"
                    GridPane.rowIndex="1"/>
                <HBox
                    spacing="5"
                    alignment="CENTER_LEFT"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="1">
                    <TextField
                        fx:id="nightEndField"
                        prefWidth="100"/>
                    <Label text=":00 (24hr)"/>
                </HBox>

            </GridPane>

            <Separator/>

            <!-- Status Label -->
            <Label
                fx:id="statusLabel"
                text=""
                styleClass="result-label"/>

            <!-- Bottom Buttons -->
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button
                    text="🔄 Reset Default"
                    styleClass="btn-secondary"
                    onAction="#onResetDefault"/>
                <Button
                    text="💾 Save Settings"
                    styleClass="btn-primary"
                    onAction="#onSaveSettings"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>