<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="ui.SavedController"
    prefWidth="520"
    prefHeight="540">

    <!-- TOP -->
    <top>
        <HBox
            styleClass="top-bar"
            alignment="CENTER_LEFT"
            spacing="10">
            <padding>
                <Insets top="0" right="20"
                        bottom="0" left="20"/>
            </padding>
            <VBox alignment="CENTER_LEFT"
                  spacing="1">
                <Label
                    text="⭐ Saved Locations"
                    styleClass="app-title"/>
                <Label
                    text="Your favourite places"
                    styleClass="app-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button
                text="← Back"
                styleClass="btn-toolbar"
                onAction="#onBack"/>
        </HBox>
    </top>

    <!-- CENTER -->
    <center>
        <VBox spacing="0">
            <padding>
                <Insets top="20" right="20"
                        bottom="20" left="20"/>
            </padding>

            <!-- Add Section -->
            <Label
                text="ADD LOCATION"
                styleClass="label-section">
                <VBox.margin>
                    <Insets bottom="14"/>
                </VBox.margin>
            </Label>

            <GridPane hgap="10" vgap="10">
                <VBox.margin>
                    <Insets bottom="10"/>
                </VBox.margin>

                <Label
                    text="Label Name"
                    styleClass="muted-label"
                    GridPane.columnIndex="0"
                    GridPane.rowIndex="0"/>
                <TextField
                    fx:id="nameField"
                    promptText="e.g. Home, Office..."
                    prefWidth="220"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="0"/>

                <Label
                    text="Location"
                    styleClass="muted-label"
                    GridPane.columnIndex="0"
                    GridPane.rowIndex="1"/>
                <ComboBox
                    fx:id="nodeCombo"
                    prefWidth="220"
                    promptText="Select location..."
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="1"/>

            </GridPane>

            <HBox alignment="CENTER_RIGHT">
                <VBox.margin>
                    <Insets bottom="20"/>
                </VBox.margin>
                <Button
                    fx:id="addBtn"
                    text="Add Location"
                    styleClass="btn-primary"
                    onAction="#onAddLocation"/>
            </HBox>

            <Separator>
                <VBox.margin>
                    <Insets bottom="16"/>
                </VBox.margin>
            </Separator>

            <!-- Saved List -->
            <Label
                text="SAVED LOCATIONS"
                styleClass="label-section">
                <VBox.margin>
                    <Insets bottom="6"/>
                </VBox.margin>
            </Label>

            <HBox spacing="8"
                  alignment="CENTER_LEFT">
                <VBox.margin>
                    <Insets bottom="10"/>
                </VBox.margin>
                <Label
                    text="Total:"
                    styleClass="muted-label"/>
                <Label
                    fx:id="totalSavedLabel"
                    text="0"
                    styleClass="result-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label
                    fx:id="statusLabel"
                    text=""
                    styleClass="success-label"/>
            </HBox>

            <ListView
                fx:id="savedListView"
                prefHeight="190"
                styleClass="list-view">
                <VBox.margin>
                    <Insets bottom="16"/>
                </VBox.margin>
            </ListView>

            <Separator>
                <VBox.margin>
                    <Insets bottom="16"/>
                </VBox.margin>
            </Separator>

            <!-- Buttons -->
            <HBox spacing="8"
                  alignment="CENTER_RIGHT">
                <Button
                    text="🔄  Refresh"
                    styleClass="btn-secondary"
                    onAction="#onRefresh"/>
                <Button
                    fx:id="deleteBtn"
                    text="🗑️  Delete Selected"
                    styleClass="btn-danger"
                    disable="true"
                    onAction="#onDeleteSelected"/>
                <Button
                    fx:id="clearAllBtn"
                    text="Clear All"
                    styleClass="btn-danger"
                    onAction="#onClearAll"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>
