<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="ui.WelcomeController"
           prefWidth="600"
           prefHeight="500"
           style="-fx-background-color: #F8FAF5;">

    <!-- ========================================= -->
    <!-- BACKGROUND DECORATIONS -->
    <!-- ========================================= -->

    <!-- Top-right green decorative circle -->
    <StackPane
            prefWidth="420"
            prefHeight="420"
            translateX="250"
            translateY="-210"
            opacity="0.20"
            style="-fx-background-color: #006A4E;
                   -fx-background-radius: 300px;"/>

    <!-- Bottom-left red decorative circle -->
    <StackPane
            prefWidth="260"
            prefHeight="260"
            translateX="-270"
            translateY="210"
            opacity="0.12"
            style="-fx-background-color: #F42A41;
                   -fx-background-radius: 200px;"/>

    <!-- Center soft green circle -->
    <StackPane
            prefWidth="400"
            prefHeight="400"
            translateY="-40"
            opacity="0.10"
            style="-fx-background-color: #009879;
                   -fx-background-radius: 250px;"/>


    <!-- ========================================= -->
    <!-- MAIN CONTENT -->
    <!-- ========================================= -->

    <VBox alignment="CENTER"
          spacing="0">

        <!-- Rickshaw Image -->
        <ImageView fx:id="rickshawImage"
                   fitWidth="220"
                   fitHeight="180"
                   preserveRatio="true">

            <VBox.margin>
                <Insets bottom="12"/>
            </VBox.margin>

        </ImageView>


        <!-- ========================================= -->
        <!-- APP NAME -->
        <!-- ========================================= -->

        <Label text="RickshawGo"
               style="-fx-text-fill: #17251F;
                      -fx-font-size: 42px;
                      -fx-font-weight: bold;
                      -fx-font-family: 'Segoe UI Black';">

            <VBox.margin>
                <Insets bottom="5"/>
            </VBox.margin>

        </Label>


        <!-- ========================================= -->
        <!-- TAGLINE -->
        <!-- ========================================= -->

        <Label text="Your Ride. Your Route. Your Way."
               style="-fx-text-fill: #006A4E;
                      -fx-font-size: 16px;
                      -fx-font-family: 'Segoe UI';
                      -fx-font-style: italic;">

            <VBox.margin>
                <Insets bottom="10"/>
            </VBox.margin>

        </Label>


        <!-- ========================================= -->
        <!-- LOCATION -->
        <!-- ========================================= -->

        <Label text="📍 Board Bazar, Gazipur"
               style="-fx-text-fill: #64746D;
                      -fx-font-size: 12px;
                      -fx-font-family: 'Segoe UI';">

            <VBox.margin>
                <Insets bottom="30"/>
            </VBox.margin>

        </Label>


        <!-- ========================================= -->
        <!-- START BUTTON -->
        <!-- ========================================= -->

        <Button fx:id="startBtn"
                text="Get Started  →"
                onAction="#onStart"

                style="-fx-background-color: #006A4E;
                       -fx-text-fill: white;
                       -fx-font-size: 15px;
                       -fx-font-weight: bold;
                       -fx-font-family: 'Segoe UI Semibold';
                       -fx-padding: 13px 45px;
                       -fx-background-radius: 10px;
                       -fx-cursor: hand;
                       -fx-effect: dropshadow(gaussian,
                           rgba(0,106,78,0.30),
                           15, 0, 0, 5);">

            <VBox.margin>
                <Insets bottom="28"/>
            </VBox.margin>

        </Button>


        <!-- ========================================= -->
        <!-- SMALL BRAND INDICATOR -->
        <!-- ========================================= -->

        <HBox alignment="CENTER"
              spacing="6">

            <!-- Green indicator -->
            <StackPane
                    prefWidth="18"
                    prefHeight="4"
                    style="-fx-background-color: #006A4E;
                           -fx-background-radius: 5px;"/>

            <!-- Red indicator -->
            <StackPane
                    prefWidth="8"
                    prefHeight="4"
                    style="-fx-background-color: #F42A41;
                           -fx-background-radius: 5px;"/>

        </HBox>


        <!-- ========================================= -->
        <!-- FOOTER -->
        <!-- ========================================= -->

        <Label text="SMART RICKSHAWGO TO HELP THE MOBILITY OF PEOPLE"
               style="-fx-text-fill: #8A9992;
                      -fx-font-size: 11px;
                      -fx-font-family: 'Segoe UI';
                      -fx-font-style: italic;">

            <VBox.margin>
                <Insets top="8"/>
            </VBox.margin>

        </Label>

    </VBox>

</StackPane>