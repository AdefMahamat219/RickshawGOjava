<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="ui.HistoryController"
    prefWidth="620"
    prefHeight="520">

    <!-- TOP -->
    <top>
        <HBox
            styleClass="top-bar"
            alignment="CENTER_LEFT"
            spacing="10">
            <padding>
                <Insets top="0" right="20"
                        bottom="0" left="20"/>
            </padding>
            <VBox alignment="CENTER_LEFT"
                  spacing="1">
                <Label
                    text="📋 Ride History"
                    styleClass="app-title"/>
                <Label
                    text="Your past fare estimates"
                    styleClass="app-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button
                text="← Back"
                styleClass="btn-toolbar"
                onAction="#onBack"/>
        </HBox>
    </top>

    <!-- CENTER -->
    <center>
        <VBox spacing="0">
            <padding>
                <Insets top="20" right="20"
                        bottom="20" left="20"/>
            </padding>

            <!-- Stats Row -->
            <HBox
                spacing="10"
                alignment="CENTER_LEFT">
                <VBox.margin>
                    <Insets bottom="16"/>
                </VBox.margin>
                <Label
                    text="Total Rides"
                    styleClass="muted-label"/>
                <Label
                    fx:id="totalRidesLabel"
                    text="0"
                    styleClass="result-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label
                    fx:id="statusLabel"
                    text=""
                    styleClass="success-label"/>
            </HBox>

            <Separator>
                <VBox.margin>
                    <Insets bottom="16"/>
                </VBox.margin>
            </Separator>

            <!-- List -->
            <ListView
                fx:id="historyListView"
                prefHeight="360"
                styleClass="list-view">
                <VBox.margin>
                    <Insets bottom="16"/>
                </VBox.margin>
            </ListView>

            <Separator>
                <VBox.margin>
                    <Insets bottom="16"/>
                </VBox.margin>
            </Separator>

            <!-- Buttons -->
            <HBox spacing="8"
                  alignment="CENTER_RIGHT">
                <Button
                    fx:id="refreshBtn"
                    text="🔄  Refresh"
                    styleClass="btn-secondary"
                    onAction="#onRefresh"/>
                <Button
                    fx:id="clearBtn"
                    text="🗑️  Clear All"
                    styleClass="btn-danger"
                    onAction="#onClearAll"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>
